{
  "name": "voxl-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "dev:compatibility": "node scripts/server.mjs",
    "test": "node --test evals/*.test.mjs",
    "studio": "node scripts/studio.mjs",
    "voxl": "node scripts/voxl.mjs",
    "render": "node scripts/studio.mjs render",
    "validate": "node scripts/studio.mjs validate",
    "import-bash": "node scripts/studio.mjs import-bash",
    "check": "npm test && npm run lint && npm run typecheck && npm run build",
    "lint": "eslint . --ignore-pattern dist",
    "typecheck": "tsc --noEmit",
    "typecheck:voxl": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 packages/engine-contracts/src/index.d.ts packages/engine-transparent-character/src/index.d.ts packages/engine-voxl-humanoid-skin/src/index.d.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
